# Copy this file to .env, then set the real values. Do not commit .env.

# --- Environment ---
# Use "development" locally. Use "production" on Render. This setting makes session
# cookies HTTPS-only in production.
ENVIRONMENT=development

# --- Database ---
# Local default, no setup needed: sqlite:///./glonk.db
# Production (Neon): postgresql+psycopg://user:password@host/dbname
DATABASE_URL=sqlite:///./glonk.db

# --- Sessions ---
# Set any long random string. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- IGDB (game data, through Twitch's developer console) ---
# Create a free app at https://dev.twitch.tv/console/apps/create
# Use any name. Set the OAuth Redirect URL to http://localhost.
# Set the Category to "Application Integration".
# Use its Client ID and a generated Client Secret below.
# This app is only for IGDB's login step. It does not use your Twitch account.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Steam (library import) ---
# Get a free key at https://steamcommunity.com/dev/apikey (needs a Steam account, any
# domain name works for the "Domain Name" field, e.g. localhost). This one key reads
# any public Steam profile's game list. It is not a per-user login.
STEAM_API_KEY=

# --- Discord OAuth2 app (web login) ---
# Get these from https://discord.com/developers/applications, on the OAuth2 page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Discord bot (server setup and /recommend) ---
# Get this from the same application, on the Bot page. Click Reset Token to reveal it.
DISCORD_BOT_TOKEN=

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173
